# apps/mobile/.env.local  (public values only — they ship inside the app)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<printed by `supabase start` or `supabase status`>

# supabase/functions/.env  (server-side secrets — NEVER prefix with EXPO_PUBLIC_)
# ANTHROPIC_API_KEY=            # used from Milestone 1 (AI logging)
# Google OAuth (supabase/config.toml reads these)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
